{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "50.2",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_extActionTitle__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://cleanmysocial.verblike.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ]
    }
  ]
}
